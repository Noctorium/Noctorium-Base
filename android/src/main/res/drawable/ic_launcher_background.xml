<?xml version="1.0" encoding="utf-8"?>
<!--
  Solid rather than a gradient.

  A gradient in a vector drawable needs an aapt:attr override, which is one more thing that can fail at
  build time for an icon background nobody looks at closely once it is masked into a circle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:fillColor="#7C4DEF" android:pathData="M0,0h108v108h-108z" />
</vector>
