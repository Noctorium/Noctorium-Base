<?xml version="1.0" encoding="utf-8"?>
<!--
  What the share sheet is allowed to hand to another app.

  Only the two places Spiceity writes audio: its own downloads folder, and the shared Music folder an
  export goes to. A provider that exposed the whole data directory would also be exposing the cookie jars
  and the encrypted credentials file sitting beside them.
-->
<paths>
    <files-path name="spiceity-downloads" path="spiceity/downloads/" />
    <external-path name="music" path="Music/" />
    <!--
      And the downloaded update, which the system package installer has to be able to read.
      Its own folder rather than the downloads one: what goes here is an APK about to be run, and it
      has no business sitting among the listener's music where the share sheet could reach it.
    -->
    <files-path name="spiceity-updates" path="updates/" />
</paths>
