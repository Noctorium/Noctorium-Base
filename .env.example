# Developer overrides, read from the environment at launch. None of these is needed to run Noctorium.
# Never commit real values.

# Where the account service is. Defaults to the noctorium-service Vercel deployment.
NOCTORIUM_SERVICE_URL=

# Discord ships with an application id built in; this only changes which application the card shows as.
NOCTORIUM_DISCORD_APPLICATION_ID=

# Lyrics providers that need a key of your own. Without them the keyless providers are used.
NOCTORIUM_BETTER_LYRICS_API_KEY=
NOCTORIUM_MUSIXMATCH_API_KEY=
NOCTORIUM_HAPPI_API_KEY=
