# Developer-owned integration identifiers only. Never commit real values.
# Last.fm ships with built-in application credentials; these only override them.
# Discord ships with an application id too; this only overrides which application the card shows as.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SPICE_LASTFM_API_KEY=
SPICE_LASTFM_SHARED_SECRET=
SPICE_DISCORD_APPLICATION_ID=

